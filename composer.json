{
    "name": "apiverve/usbvendorlookup",
    "description": "USB Vendor Lookup allows you to identify USB device manufacturers and products by their vendor ID and product ID. It uses the Linux USB ID Repository, which contains thousands of USB vendor and product identifiers.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "usbvendorlookup",
        "usb vendor lookup",
        "usb id lookup",
        "usb vendor id",
        "usb product id",
        "usb device identification"
    ],
    "homepage": "https://apiverve.com/marketplace/usbvendorlookup?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/usbvendorlookup",
        "source": "https://github.com/apiverve/usbvendorlookup-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Usbvendorlookup\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Usbvendorlookup\\Tests\\": "php/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
